rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Only authenticated sessions (email/password login) may read/write.
      // Unauthenticated and anonymous access is rejected.
      // ponytail: when multiple staff accounts exist, split by role
      // (e.g. admin-only writes to pengaturan; teachers read/write their data).
      allow read, write: if request.auth != null;
    }
  }
}